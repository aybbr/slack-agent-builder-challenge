# ============================================================
# Shared infrastructure — read by both services
# ============================================================

# Server binding (Railway auto-assigns $PORT per service)
# PORT=8000

# ============================================================
# MCP Service — read by src/tracey/mcp_server/server.py
# and src/tracey/app.py
# ============================================================

# DuckDB database path
DUCKDB_PATH=data/demo.duckdb

# dbt project root (used to resolve compiled SQL paths from manifest)
DBT_PROJECT_DIR=dbt_project

# dbt manifest (auto-detected by default but can be overridden)
# MANIFEST_PATH=dbt_project/target/manifest.json

# GitHub (PR annotation via github_service)
GITHUB_TOKEN=ghp_your_personal_access_token
GITHUB_REPO=aybbr/slack-agent-builder-challenge

# Slack signature verification (required for MCP server)
SLACK_SIGNING_SECRET=your-signing-secret

# Set to "1" to bypass Slack signature checks in local dev
TRACEY_SKIP_SIGNATURE_CHECK=0

# ============================================================
# Slack Agent Service — read by src/tracey/slack_agent/app.py
# and src/tracey/slack_agent/handlers.py
# ============================================================

SLACK_BOT_TOKEN=xoxb-your-bot-token

# User OAuth token for RTS search (assistant.search.context).
# Required scopes: search:read.public, search:read.users
SLACK_USER_TOKEN=xoxp-your-user-token

# Signing secret is shared with the MCP service — same Slack App.
# Also uses: DUCKDB_PATH, DBT_PROJECT_DIR, MANIFEST_PATH,
# GITHUB_TOKEN, GITHUB_REPO (shared with MCP service above).
